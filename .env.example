# REQUIRED VARIABLES

# Your Discord bot token (get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Discord Guild ID - the one guild this instance serves
DISCORD_GUILD_ID=123456789012345678

# OPTIONAL FEATURES (leave blank to disable)

# Channel the bot keeps the server list in. Give it a channel of its own!
EMBED_CHANNEL_ID=123456789012345678

# Discord role ID with admin access (optional - empty limits admin commands to Administrators and the guild owner)
ADMIN_ROLE_ID=123456789012345678

# Channel used when a DM cannot be delivered, leave empty to disable fallback notifications
FALLBACK_CHANNEL_ID=123456789012345678

# Optional Variables (uncomment to change default)

# Activity text, up to 128 characters. Leave blank to show no activity at all.
BOT_ACTIVITY_TEXT=/follow <map> for map change alerts

# Choose activity listed: custom, playing, listening, watching, competing
BOT_ACTIVITY_TYPE=custom

# Log levels: trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=info

# Embed color as hex, with or without the leading "#"
EMBED_COLOR=#79C4D0

# Path to SQLite database file (default: db.sqlite in working directory).
# Leave this commented out for Docker: the image defaults it to /app/data/db.sqlite
# The bot also remembers its server list message here.
#DATABASE_PATH=db.sqlite

# How often to query servers in seconds, update the embeds and check for map changes
SERVER_UPDATE_INTERVAL=90

# HTTP port for healthcheck. 0 opens no socket, which fails the Docker healthcheck.
#HEALTH_PORT=3000

# Health check bind address. Default keeps it inside the container.
#HEALTH_HOST=127.0.0.1

# Maximum retry attempts for failed operations
RETRY_MAX_RETRIES=3

# Base delay for exponential backoff (seconds)
RETRY_BASE_DELAY=1

# Maximum retries for GameDig server queries. This is a multiplier over the ports
# GameDig tries, so raising it multiplies the time an unreachable server costs. A
# refresh pass is capped at 80% of SERVER_UPDATE_INTERVAL either way, and servers not
# reached by then are shown offline for that tick.
GAMEDIG_MAX_RETRIES=4

# Icon shown in embed footers
FALLBACK_AVATAR_URL=https://i.imgur.com/cBiDnMi.png

# Image for offline servers
OFFLINE_SERVER_IMAGE=https://i.imgur.com/WnS0Biz.png

# Base URL for map thumbnail images, applied to every map as `<base><mapname>.jpg`.
# Leave blank to disable map images entirely.
MAP_IMAGE_BASE_URL=https://bans.snksrv.com/images/maps/

# Maximum follow commands per minute per user
RATE_LIMIT_FOLLOW_PER_MINUTE=5

# Maximum unfollow commands per minute per user
RATE_LIMIT_UNFOLLOW_PER_MINUTE=5

# Maximum map-change DMs per minute per user. The same map again within a minute
# (one map on two servers) sends no second DM and does not count against this.
RATE_LIMIT_NOTIFICATION_PER_MINUTE=10

# Maximum maps a single user may follow at once.
MAX_FOLLOWS_PER_USER=50

# Maximum users DMed for a single map change. Beyond this the fanout is truncated
# and the count is logged and included in the fallback channel post.
MAX_NOTIFICATION_RECIPIENTS=200
